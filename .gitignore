# Build output
bin/
build/
*.exe
*.o
*.obj
*.so
*.dylib
*.dll

# Odin build cache
.cache/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc

# ---------------------------------------------------------------------------
# Generated world data. tools/generate_map.py writes these; they are ~28 MB and
# regenerable. data/.gdignore must stay tracked - Godot reads it to skip
# importing data/ as resources, and without it the CSVs get imported as
# translation files and break at runtime.
# ---------------------------------------------------------------------------
assets/data/*.csv
data/*.csv

# Godot tries to import the generator's output dir as CSV translations. Its
# artifacts point at CSVs that are not committed, so they break a fresh clone.
assets/data/*.import
assets/data/*.translation

# ---------------------------------------------------------------------------
# Godot
# ---------------------------------------------------------------------------
.godot/
*.translation

# .uid files next to scripts and scenes ARE tracked. They are how Godot 4.4+
# resolves resource references, so losing them breaks scenes on other machines.

# Godot export output
export/
android/
